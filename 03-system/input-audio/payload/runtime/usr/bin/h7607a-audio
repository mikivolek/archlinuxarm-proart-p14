#!/usr/bin/python3
"""Change the desktop user's default playback volume or mute state."""
import argparse
import os
import subprocess
import sys


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("up", "down", "mute"))
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        print("audio: run this command as the desktop user", file=sys.stderr)
        return 1
    command = ["/usr/bin/wpctl"]
    if args.action == "mute":
        command += ["set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]
    else:
        command += ["set-volume", "--limit", "1.0", "@DEFAULT_AUDIO_SINK@",
                    "5%+" if args.action == "up" else "5%-"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5, check=False)
    except FileNotFoundError:
        print("audio: wpctl is missing; install wireplumber", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("audio: the audio service did not respond within five seconds", file=sys.stderr)
        return 1
    except OSError as exc:
        print("audio: " + str(exc), file=sys.stderr)
        return 1
    if result.returncode:
        detail = next((line.strip() for line in result.stderr.splitlines() if line.strip()),
                      "default playback device unavailable")
        print("audio: " + detail[:300], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
