pkgname=nvidia-n1x-modules
pkgver=615.78.08
pkgrel=4
pkgdesc='NVIDIA modules with verified H7607BA DRM and semaphore leak backport'
arch=(aarch64)
url='https://github.com/NVIDIA/open-gpu-kernel-modules'
license=('MIT' 'GPL-2.0-only')
depends=('nvidia-utils=615.78.08-1' 'linux-n1x-nvidia-bin=7.0.0.1022.23-3' kmod)
provides=('nvidia=615.78.08' 'nvidia-open=615.78.08' 'NVIDIA-MODULE')
conflicts=(nvidia nvidia-open nvidia-dkms nvidia-open-dkms nvidia-lts nvidia-open-lts)
options=(!strip !debug)
source=(nvidia.ko.zst nvidia-modeset.ko.zst nvidia-uvm.ko.zst nvidia-drm.ko COPYING)
noextract=("${source[@]:0:4}")
sha256sums=('e38370575be91aa186ee7c18b8d7e81435ae7825740304c7295d7eb9f8a4b661' '3a1e3c07802314073eaaa03846cdd6bd197deec9674f7860fb72479fe3a3b6b5' '75a674e888a75c2c368ef868ed28749cd9add2dfed3783699ded86ac4992ac9c' '9b0ceddf9da11337e9b9af1dd1c77e81fc3559cc1bfcdcc67cccd604d72e83bf' 'd8e96d29bc323000e7ba56102d77c88226a7a3d0d94e2081cb4b071ae9de4a06')
package() {
  local module
  for module in "${noextract[@]}"; do
    install -Dm644 "$srcdir/$module" "$pkgdir/usr/lib/modules/7.0.0-1022-nvidia/updates/h7607a/$module"
  done
  install -Dm644 "$srcdir/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
