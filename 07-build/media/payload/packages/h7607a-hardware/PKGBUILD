# Exact retained H7607BA assets plus native ABI-verified SoundWire backport.
# pkgrel 7: UVC webcam enabled (driver no longer blacklisted, V4L2 monitor on).
# pkgrel 6: internal microphone and headset microphone capture.
# pkgrel 5: ProArt P14 H7407BA keyboard, audio identity, touchpad and Cirrus 33A1 support.
pkgname=h7607a-hardware
pkgver=1.0.0
pkgrel=7
pkgdesc='ASUS H7607BA/H7407BA keyboard, audio, input and boot support with SoundWire race repair'
arch=('aarch64')
url='https://github.com/pfeifferj/archlinuxarm-proart-p16'
license=('GPL-2.0-only' 'GPL-2.0-or-later' 'MIT' 'BSD-3-Clause')
depends=('linux-n1x-nvidia-bin=7.0.0.1022.23-3' 'kmod' 'mkinitcpio' 'python' 'systemd')
optdepends=(
  'alsa-lib: speaker and headphone UCM profile'
  'libinput: PixArt touchpad pressure quirk'
  'wireplumber: playback policy and the h7607a-audio volume helper'
)
backup=('etc/mkinitcpio.conf.d/h7607a.conf')
options=('!strip' '!debug')
source=(
  'hid-asus.ko'
  'mt8901-acp-sdw-legacy-mach.ko'
  'initcpio-install'
  'initcpio-hook'
  'mkinitcpio.conf'
  'depmod.conf'
  'nvidia.conf'
  'n1x-cppc-init.py'
  'n1x-cppc-init.service'
  'soundwire-mtk.ko'
  'mt8901-soundwir.conf'
  'P16-playback.conf'
  '51-h7607a-playback.conf'
  '60-h7607a-touchpad.quirks'
  'h7607a-audio'
  'h7607a-brightness'
  'LICENSE'
  'LICENSE.ucm'
)
