package() {
  install -Dm644 "$srcdir/hid-asus.ko" "$pkgdir/usr/lib/modules/7.0.0-1022-nvidia/updates/h7607a/hid-asus.ko"
  install -Dm644 "$srcdir/mt8901-acp-sdw-legacy-mach.ko" "$pkgdir/usr/lib/modules/7.0.0-1022-nvidia/updates/h7607a/mt8901-acp-sdw-legacy-mach.ko"
  install -Dm644 "$srcdir/initcpio-install" "$pkgdir/usr/lib/initcpio/install/h7607a-preload"
  install -Dm644 "$srcdir/initcpio-hook" "$pkgdir/usr/lib/initcpio/hooks/h7607a-preload"
  install -Dm644 "$srcdir/mkinitcpio.conf" "$pkgdir/etc/mkinitcpio.conf.d/h7607a.conf"
  install -Dm644 "$srcdir/depmod.conf" "$pkgdir/usr/lib/depmod.d/h7607a.conf"
  install -Dm644 "$srcdir/nvidia.conf" "$pkgdir/usr/lib/modprobe.d/h7607a-nvidia.conf"
  install -Dm644 "$srcdir/n1x-cppc-init.py" "$pkgdir/usr/lib/h7607a/n1x-cppc-init.py"
  install -Dm644 "$srcdir/n1x-cppc-init.service" "$pkgdir/usr/lib/systemd/system/n1x-cppc-init.service"
  install -Dm644 "$srcdir/soundwire-mtk.ko" "$pkgdir/usr/lib/modules/7.0.0-1022-nvidia/updates/h7607a/soundwire-mtk.ko"
  install -Dm644 "$srcdir/mt8901-soundwir.conf" "$pkgdir/usr/share/alsa/ucm2/conf.d/mt8901-soundwir/mt8901-soundwir.conf"
  install -Dm644 "$srcdir/P16-playback.conf" "$pkgdir/usr/share/alsa/ucm2/MediaTek/mt8901-soundwir/P16-playback.conf"
  install -Dm644 "$srcdir/51-h7607a-playback.conf" "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-h7607a-playback.conf"
  install -Dm644 "$srcdir/60-h7607a-touchpad.quirks" "$pkgdir/usr/share/libinput/60-h7607a-touchpad.quirks"
  install -Dm755 "$srcdir/h7607a-audio" "$pkgdir/usr/bin/h7607a-audio"
  install -Dm755 "$srcdir/h7607a-brightness" "$pkgdir/usr/bin/h7607a-brightness"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/LICENSE.ucm" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ucm"
}
