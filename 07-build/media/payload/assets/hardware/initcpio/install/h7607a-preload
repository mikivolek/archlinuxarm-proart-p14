#!/bin/bash
# SPDX-License-Identifier: MIT
build() {
    # Built in an ARM VM: autodetect cannot discover the P16's USB/I2C paths.
    local controller firmware
    for controller in nvme xhci_pci xhci_plat_hcd xhci_mtk_hcd usb_storage uas i2c_mt65xx i2c_hid_acpi usbhid hid_generic hid_multitouch; do
        add_module "$controller" || return 1
    done
    add_module hid_asus || return 1
    add_module nvidia || return 1
    add_module nvidia_modeset || return 1
    add_module nvidia_uvm || return 1
    add_module nvidia_drm || return 1
    add_module mt8901_acp_sdw_legacy_mach || return 1
    add_module soundwire_mtk || return 1
    add_file /usr/lib/modprobe.d/h7607a-nvidia.conf || return 1
    # The Cirrus tuning files are not redistributable; only owner-installed copies exist.
    for firmware in cs35l56-b0-dsp1-misc-104333a1-spkid0.wmfw cs35l56-b0-dsp1-misc-104333a1-spkid0-l1u0.bin cs35l56-b0-dsp1-misc-104333a1-spkid0-l1u1.bin; do
        if [[ -f /usr/lib/firmware/cirrus/$firmware ]]; then
            add_file "/usr/lib/firmware/cirrus/$firmware" || return 1
        fi
    done
    add_runscript || return 1
}
help() {
    echo 'Load the exact H7607BA keyboard driver before udev and include qualified display/audio assets.'
}
